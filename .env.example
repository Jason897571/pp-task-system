# Copy to .env before running: cp .env.example .env
# docker compose automatically reads the .env file in this directory.

# ===== Web (public) =====
# Host port the app is served on → open http://localhost:${WEB_PORT}
WEB_PORT=8080
# Public origin used for backend CORS. Must match how users reach the app.
CORS_ORIGIN=http://localhost:8080

# ===== MySQL =====
MYSQL_ROOT_PASSWORD=Root_Pw_2026!
MYSQL_DATABASE=task_system
MYSQL_USER=task_app
MYSQL_PASSWORD=Task_App_2026!
TZ=Asia/Shanghai

# ===== Backend =====
# host is the compose service name `db`. The password's '!' MUST be URL-encoded
# as %21 here (it is the literal MYSQL_PASSWORD above, just URL-escaped).
DATABASE_URL=mysql+pymysql://task_app:Task_App_2026%21@db/task_system
# CHANGE THIS to a long random string in production.
JWT_SECRET=change-me-to-a-long-random-string
JWT_EXPIRE_MINUTES=720
# 1 = create demo accounts (super/admin/member …) on first boot (idempotent).
# Set to 0 for a clean production database.
RUN_SEED=1
